# Production environment — copy to your host (Render, Railway, etc.) as secrets.
# Never commit real values.
# See docs/production-env-checklist.md for setup steps.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=generate-a-long-random-string-here
DEBUG=False

# API domain(s), comma-separated (no scheme). On Render, RENDER_EXTERNAL_HOSTNAME
# is merged automatically so the default *.onrender.com host works without listing it.
ALLOWED_HOSTS=api.yourdomain.com

# Frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# PostgreSQL (managed DB connection string)
DATABASE_URL=postgres://user:password@host:5432/civic_education
# Optional read replica (enables apps.core.db.ReadReplicaRouter)
DATABASE_URL_REPLICA=

# Public frontend URL (HTTPS) — used in emails and billing redirects
FRONTEND_URL=https://app.yourdomain.com

# Public workspace for citizen sign-ups (run seed_data to create)
PUBLIC_ORGANIZATION_SLUG=platform-demo

# JWT lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Privileged-role idle timeout (seconds) — server-enforced
SESSION_IDLE_TIMEOUT_SECONDS=1800

# SMTP (transactional email — processed by Celery worker)
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Supabase Storage (certificate PDFs, avatar uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=civic-platform

# Redis + Celery (REQUIRED in production)
CELERY_BROKER_URL=redis://:password@redis-host:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
REDIS_URL=redis://:password@redis-host:6379/0

# Billing — stripe for paid SaaS; dummy when payments are not used (see ALLOW_DUMMY_BILLING_IN_PRODUCTION)
BILLING_PROVIDER=dummy
ALLOW_DUMMY_BILLING_IN_PRODUCTION=True
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# AI Tutor — optional; blank = stub responses (not for production learners)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# SMS — optional; dummy = log only. Set on web AND worker.
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Web Push — optional; generate: npx web-push generate-vapid-keys
# Set same public key in frontend VITE_VAPID_PUBLIC_KEY at build time
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@yourdomain.com

# Enterprise SSO (OpenID Connect) — Enterprise plan required
API_BASE_URL=https://api.yourdomain.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://api.yourdomain.com/api/auth/sso/callback/
OIDC_SCOPES=openid email profile

# Observability (required in production unless REQUIRE_SENTRY=False)
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
REQUIRE_SENTRY=True
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# Database backups (cron job / manual pg_dump)
BACKUP_DIR=/var/data/backups
BACKUP_RETAIN_DAYS=14
