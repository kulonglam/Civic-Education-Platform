# Production environment — copy to your host (Render, Railway, etc.) as secrets.
# Never commit real values.
# See docs/production-env-checklist.md for setup steps.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=generate-a-long-random-string-here
DEBUG=False

# API domain(s), comma-separated (no scheme). On Render you can leave this empty:
# RENDER_EXTERNAL_HOSTNAME is merged automatically (*.onrender.com works without a custom domain).
ALLOWED_HOSTS=api.yourdomain.com

# Extra frontend origins (optional). FRONTEND_URL is always added to CORS.
# CORS_ALLOWED_ORIGINS=https://civic-education-web-xxxx.onrender.com

# PostgreSQL (managed DB connection string)
DATABASE_URL=postgres://user:password@host:5432/civic_education
# Optional read replica (enables apps.core.db.ReadReplicaRouter)
DATABASE_URL_REPLICA=

# Public frontend URL (HTTPS) — emails, CORS, WebSockets. Custom domain not required:
# FRONTEND_URL=https://civic-education-web-xxxx.onrender.com
FRONTEND_URL=https://app.yourdomain.com

# Public support mailbox (Contact page). Empty = no mailto shown.
SUPPORT_EMAIL=support@yourdomain.com

# Public workspace for citizen sign-ups (run seed_data to create)
PUBLIC_ORGANIZATION_SLUG=platform-demo

# JWT lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Privileged-role idle timeout (seconds) — server-enforced
SESSION_IDLE_TIMEOUT_SECONDS=1800

# SMTP (blocked on Render free web services — use BREVO_API_KEY instead)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Brevo REST API key from SMTP & API → API Keys (not the SMTP key)
BREVO_API_KEY=

# Supabase Storage (certificate PDFs, avatar uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=civic-platform

# Redis + Celery (REQUIRED in production)
CELERY_BROKER_URL=redis://:password@redis-host:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
REDIS_URL=redis://:password@redis-host:6379/0

# Billing — East Africa default is invoice / card upgrade (dummy provider).
# Paid self-serve checkout is locked; Super Admins assign plans in Admin → Organizations.
BILLING_PROVIDER=dummy
ALLOW_DUMMY_BILLING_IN_PRODUCTION=True
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# Append-only audit replica (JSONL). Put this on the backup disk or object storage.
AUDIT_WORM_PATH=

# AI Tutor — optional; no credentials = stub responses (not for production learners)
# auto picks Anthropic, then OpenAI-compatible, then the stub.
TUTOR_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024
# $0 on Render: Groq free tier (OpenAI-compatible, not GPT). Key from https://console.groq.com
# TUTOR_PROVIDER=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
# OPENAI_MAX_TOKENS=1024
# Paid OpenAI / OpenRouter:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1024
# Article auto-translation on save (same provider as the tutor). Stub never writes article fields.
TRANSLATION_ENABLED=True
TRANSLATION_MAX_TOKENS=4096
TRANSLATION_CHUNK_CHARS=3000

# SMS — optional; dummy = log only. Set on web AND worker.
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp Cloud API — optional; dummy = log only. Share-to-WhatsApp links still work.
WHATSAPP_PROVIDER=dummy
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=
# Approved Meta content template for outbound alerts (body variable {{1}} = message).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_BODY_VARS=1

# Web Push — optional; generate: npx web-push generate-vapid-keys
# Set same public key in frontend VITE_VAPID_PUBLIC_KEY at build time
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@yourdomain.com

# Enterprise SSO (OpenID Connect) — Enterprise plan required
API_BASE_URL=https://api.yourdomain.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://api.yourdomain.com/api/auth/sso/callback/
OIDC_SCOPES=openid email profile

# Observability (required in production unless REQUIRE_SENTRY=False)
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
REQUIRE_SENTRY=True
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# Database backups (cron job / manual pg_dump)
BACKUP_DIR=/var/data/backups
BACKUP_RETAIN_DAYS=14
