# ─────────────────────────────────────────────────────────────────
#  Civic Education RSS – Backend environment variables
#  Copy this file to .env and fill in real values before running.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────

# ── Django core ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_education

# ── Redis (cache + Celery broker + Channels layer) ───────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False   # set True in production (requires HTTPS)
JWT_COOKIE_SAMESITE=Lax

# ── Frontend / CORS ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://127.0.0.1:8000
PUBLIC_ORGANIZATION_SLUG=platform-demo

# ── Email ────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=noreply@civic-education.ss
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_TLS=True

# ── AI Tutor ─────────────────────────────────────────────────────
# auto = use Anthropic if keyed, else OpenAI-compatible, else offline stub.
# Force one with: anthropic | openai | stub
TUTOR_PROVIDER=auto

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL blank for OpenAI itself.
# Free local models via Ollama (`ollama serve && ollama pull llama3.1`):
#   TUTOR_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

# ── SMS (Africa's Talking) ───────────────────────────────────────
SMS_PROVIDER=dummy          # set to 'africastalking' in production
AT_USERNAME=your-at-username
AT_API_KEY=your-at-api-key
AT_SENDER_ID=CIVICED

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key); print(v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@civic-education.ss

# ── Billing (Stripe) ─────────────────────────────────────────────
BILLING_PROVIDER=dummy      # set to 'stripe' in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── File storage (Supabase) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=civic-platform

# ── Enterprise SSO (OpenID Connect) ──────────────────────────────
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback/
OIDC_SCOPES=openid email profile

# ── Observability ────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
