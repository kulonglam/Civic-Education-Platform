# ─────────────────────────────────────────────────────────────────
#  Civic Education RSS – Frontend environment variables
#  Copy this file to .env and fill in real values.
#  All public variables MUST start with VITE_ to be embedded in the bundle.
# ─────────────────────────────────────────────────────────────────

# Django API base URL (must end WITHOUT a trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# WebSocket base URL for live notifications (ws:// or wss://)
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Default tenant slug for citizen (public) sign-ups
VITE_DEFAULT_TENANT_SLUG=platform-demo

# Set to "true" to enable the PWA install prompt in development
# VITE_PWA_DEV=false
