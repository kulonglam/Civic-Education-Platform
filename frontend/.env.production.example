# Production frontend — set before npm run build (or in static host build env)
# See docs/production-env-checklist.md

# Custom domain not required — use the Render API URL:
# VITE_API_BASE_URL=https://civic-education-api-xxxx.onrender.com/api
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Must match backend PUBLIC_ORGANIZATION_SLUG (default from seed_data)
VITE_DEFAULT_TENANT_SLUG=platform-demo

# Web push — must match backend VAPID_PUBLIC_KEY exactly
# Generate: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Error tracking / APM (recommended in production)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION=0
VITE_SENTRY_REPLAYS_ON_ERROR=1
